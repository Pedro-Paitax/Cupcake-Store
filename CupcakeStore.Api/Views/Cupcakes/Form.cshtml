@model CupcakeFormViewModel
@{
    ViewData["Title"] = Model.Edicao ? "Editar cupcake" : "Novo cupcake";
    var recursos = new[] { "chocolate", "morango", "baunilha", "velvet", "limao", "doce", "caramelo", "cenoura" };
}
<header class="topo">
    <a class="link-voltar" asp-action="Index">← Cardápio</a>
    <h1>@ViewData["Title"]</h1>
</header>

<section class="grade-form">
    <form asp-action="Salvar" method="post" class="cartao formulario" novalidate>
        <div asp-validation-summary="ModelOnly" class="aviso erro" role="alert"></div>
        <input type="hidden" asp-for="Id" />

        <label asp-for="Nome">Nome</label>
        <input asp-for="Nome" maxlength="80" placeholder="Cupcake de Pistache" />
        <span asp-validation-for="Nome" class="erro-campo"></span>

        <label asp-for="Descricao">Descrição</label>
        <textarea asp-for="Descricao" rows="4" maxlength="500" placeholder="Massa, recheio e cobertura..."></textarea>
        <span asp-validation-for="Descricao" class="erro-campo"></span>

        <label asp-for="Preco">Preço (R$)</label>
        <input asp-for="Preco" type="number" step="0.01" min="0.01" max="9999.99" inputmode="decimal" />
        <span asp-validation-for="Preco" class="erro-campo"></span>

        <label asp-for="Imagem">Imagem</label>
        <input asp-for="Imagem" list="recursos" placeholder="chocolate ou https://..." data-previa="#previa" />
        <datalist id="recursos">
            @foreach (var r in recursos)
            {
                <option value="@r"></option>
            }
        </datalist>
        <small class="dica">Use um dos nomes de imagem do app (lista ao digitar) ou cole a URL de uma foto.</small>
        <span asp-validation-for="Imagem" class="erro-campo"></span>

        <label class="check"><input asp-for="Ativo" /> Disponível no cardápio</label>

        <div class="linha-botoes">
            <button type="submit" class="botao">Salvar</button>
            <a class="botao secundario" asp-action="Index">Cancelar</a>
        </div>
    </form>
    <aside class="cartao previa">
        <h2>Prévia</h2>
        <img id="previa" src="@(string.IsNullOrWhiteSpace(Model.Imagem) ? "/img/logo_cupcake.png" : Formatacao.UrlImagem(Model.Imagem))" alt="Prévia da imagem" />
    </aside>
</section>
