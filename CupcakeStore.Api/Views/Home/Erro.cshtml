@{
    ViewData["Title"] = "Ops";
    var codigo = ViewBag.Codigo as int?;
    var (titulo, texto) = codigo switch
    {
        404 => ("Página não encontrada", "O endereço que você tentou abrir não existe."),
        403 => ("Acesso negado", "Você não tem permissão para ver esta página."),
        _ => ("Algo deu errado", "Tivemos um problema ao processar sua solicitação. Tente novamente em instantes.")
    };
}
<section class="boas-vindas">
    <span class="emoji-grande">🧁💥</span>
    <h1>@titulo</h1>
    <p class="sub">@texto</p>
    <a class="botao" href="/">Voltar ao início</a>
</section>
